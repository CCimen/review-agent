{
  "name": "review-agent-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "openapi-typescript openapi.json -o src/api.generated.ts",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "dev:preview": "vite --config preview/vite.config.ts",
    "check:preview": "tsc --project preview/tsconfig.json",
    "build:preview": "npm run check:preview && vite build --config preview/vite.config.ts",
    "serve:preview": "vite preview --config preview/vite.config.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.5.4",
    "@astryxdesign/theme-neutral": "0.5.4",
    "@fontsource/figtree": "5.3.0",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "5.102.8",
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.3",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "swagger-ui": "5.32.15"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.5.4",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/swagger-ui": "5.32.0",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
