{
  "include": [
    "bootstrap/plugins/review_agent_tools",
    "bootstrap/install.py",
    "scripts/validate_release_tag.py",
    "tools"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache"
  ],
  "typeCheckingMode": "strict",
  "pythonVersion": "3.11",
  "pythonPlatform": "Linux",
  "reportImportCycles": "error",
  "reportMissingImports": "error",
  "reportMissingModuleSource": "error",
  "reportMissingTypeStubs": "error",
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": [
        "tools",
        "bootstrap/plugins"
      ]
    },
    {
      "root": "bootstrap/plugins",
      "extraPaths": [
        "bootstrap/plugins"
      ]
    }
  ]
}
