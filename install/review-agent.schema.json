{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccimen.github.io/review-agent/review-agent-installation.schema.json",
  "title": "Review Agent installation plan",
  "description": "Non-secret inputs for one App-only Review Agent deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deployment", "github", "runtime", "operations"],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "platform",
        "public_url",
        "image",
        "profile",
        "model_provider",
        "model",
        "reasoning_effort",
        "timezone",
        "advisory_only",
        "feedback_enabled"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": ["compose", "openshift"]
        },
        "public_url": {
          "type": "string",
          "pattern": "^https://[^/?#]+(?:\\.[^/?#]+)+(?:/[A-Za-z0-9._~-]*)?$"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "digest"],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
            }
          }
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "model_provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "reasoning_effort": {
          "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "advisory_only": {
          "const": true
        },
        "feedback_enabled": {
          "type": "boolean"
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "owner_type", "installation_mode", "repositories"],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$"
        },
        "owner_type": {
          "enum": ["user", "organization"]
        },
        "installation_mode": {
          "const": "selected_repositories"
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["full_name", "enabled", "trigger_mode", "profile"],
            "properties": {
              "full_name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "enabled": {
                "type": "boolean"
              },
              "trigger_mode": {
                "const": "manual"
              },
              "profile": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_replicas",
        "worker_concurrency",
        "active_job_limit",
        "publication_replicas"
      ],
      "properties": {
        "worker_replicas": {
          "type": "integer",
          "minimum": 1
        },
        "worker_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "active_job_limit": {
          "type": "integer",
          "minimum": 1
        },
        "publication_replicas": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backups"],
      "properties": {
        "backups": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "owner"],
          "properties": {
            "enabled": {
              "const": true
            },
            "owner": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
