HERMES_IMAGE=nousresearch/hermes-agent:v2026.8.3@sha256:16788311e2fa3035456bdc1bafb8ec2b1777db64ebf020af9bb7eb73c3712c9e
REVIEW_AGENT_IMAGE=review-agent:local
TZ=Europe/Stockholm
REVIEW_AGENT_PROFILE=sundsvall-standard
REVIEW_AGENT_INGRESS_NETWORK=dokploy-network

# One private PostgreSQL database serves each Review Agent environment. Use the
# same URL-safe random password in both values (for example: openssl rand -hex 32).
POSTGRES_IMAGE=postgres:17-alpine
REVIEW_AGENT_POSTGRES_PASSWORD=replace-with-one-url-safe-random-password
REVIEW_AGENT_DATABASE_URL=postgresql://review_agent:replace-with-one-url-safe-random-password@review-postgres:5432/review_agent
# Supports about 100 worker slots plus the other bundled service pools.
REVIEW_AGENT_POSTGRES_MAX_CONNECTIONS=200

# Dokploy routes an HTTPS domain to review-admission on port 8644.
REVIEW_AGENT_GITHUB_APP_WEBHOOK_SECRET=replace-with-output-of-openssl-rand-hex-32
REVIEW_AGENT_GITHUB_APP_ID=123456
# A host path only; never place the PEM contents in this environment file.
REVIEW_AGENT_GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem
REVIEW_AGENT_GITHUB_GATEWAY_MAX_CONCURRENT_REQUESTS=8
API_SERVER_KEY=replace-with-third-output-of-openssl-rand-hex-32

REVIEW_AGENT_PUBLISH_MAX_BYTES=60000
REVIEW_AGENT_PUBLICATION_MAX_ATTEMPTS=3
REVIEW_AGENT_PUBLICATION_LEASE_SECONDS=120
REVIEW_AGENT_PUBLICATION_HEARTBEAT_SECONDS=30
REVIEW_AGENT_PUBLICATION_RETRY_SECONDS=30
REVIEW_AGENT_PUBLICATION_POLL_SECONDS=2

REVIEW_AGENT_FEEDBACK_ENABLED=true

# Queue limits protect shared compute; they do not limit PR or source size.
REVIEW_AGENT_ACTIVE_JOB_LIMIT=100
REVIEW_AGENT_JOB_MAX_ATTEMPTS=3
REVIEW_AGENT_JOB_PRIORITY=0
REVIEW_AGENT_JOB_PRIORITY_AGING_SECONDS=900

# Admission request bounds are operator-tunable denial-of-service controls.
# Native App payloads may be smaller; this deployment's maximum is 2097152.
REVIEW_AGENT_GITHUB_APP_MAX_BODY_BYTES=2097152
REVIEW_AGENT_ADMISSION_MAX_CONCURRENT_REQUESTS=8
REVIEW_AGENT_ADMISSION_REQUEST_TIMEOUT_SECONDS=30

# Concurrent reviews per worker process. Total slots equal replicas times this value.
# Keep the heartbeat below half of the lease.
REVIEW_AGENT_WORKER_CONCURRENCY=4
REVIEW_AGENT_JOB_LEASE_SECONDS=120
REVIEW_AGENT_JOB_HEARTBEAT_SECONDS=30
REVIEW_AGENT_JOB_RETRY_SECONDS=30
REVIEW_AGENT_JOB_POLL_SECONDS=2
REVIEW_AGENT_JOB_RECOVERY_SECONDS=30
REVIEW_AGENT_JOB_RECOVERY_BATCH_SIZE=100
REVIEW_AGENT_HERMES_TIMEOUT_SECONDS=7200

# Keep unrelated network surfaces disabled.
HERMES_DASHBOARD=0
PYTHONUNBUFFERED=1
