# Values a deployment must set, plus the optional integrations.
# Every other variable has a working default in the Compose files; see
# docs/OPERATIONS.md#configuration-reference for the full list. After setup,
# settings saved in the admin panel override the matching defaults; see
# docs/ADMIN_PANEL.md#environment-defaults-and-admin-controls.

# --- Images ---
HERMES_IMAGE=nousresearch/hermes-agent:v2026.8.31@sha256:64923faeae267792bf9bf87fe3b4c4869e35004e360c7df01730ad801b74d524
# Local builds use this tag. Production must override it with the release
# manifest reference from IMAGE-DIGESTS.txt: ghcr.io/...@sha256:<digest>.
REVIEW_AGENT_IMAGE=review-agent:local
# Resolve this tag once and store its repository digest in production.
POSTGRES_IMAGE=postgres:17-alpine

# --- Model (required) ---
# The default Codex route uses Hermes' ChatGPT device-code login, so it needs no
# model API key here. REVIEW_AGENT_MODEL has no default: set it to a model the
# provider account offers. Keep provider credentials in Hermes' own auth store.
REVIEW_AGENT_MODEL_PROVIDER=openai-codex
REVIEW_AGENT_MODEL=
REVIEW_AGENT_REASONING_EFFORT=xhigh

# --- PostgreSQL (required) ---
# The migration owner password appears in the first two values; the runtime URL
# uses a second URL-safe password (for example two outputs of openssl rand -hex 32).
REVIEW_AGENT_POSTGRES_PASSWORD=replace-with-migration-owner-password
REVIEW_AGENT_DATABASE_URL=postgresql://review_agent:replace-with-migration-owner-password@review-postgres:5432/review_agent
REVIEW_AGENT_RUNTIME_DATABASE_URL=postgresql://review_agent_runtime:replace-with-runtime-password@review-postgres:5432/review_agent

# --- GitHub App (required) ---
# See docs/GITHUB_APP_PILOT.md. The webhook reaches review-admission on port 8644.
REVIEW_AGENT_GITHUB_APP_WEBHOOK_SECRET=replace-with-the-webhook-secret-set-on-the-app
REVIEW_AGENT_GITHUB_APP_ID=123456
# A host path only; never place the PEM contents in this file.
# On Dokploy, use the File Mount path from docs/DEPLOYMENT.md.
REVIEW_AGENT_GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem

# --- Internal service key (required) ---
API_SERVER_KEY=replace-with-output-of-openssl-rand-hex-32

# --- Behavior ---
# Include feedback instructions in reviews. Feedback commands work either way.
REVIEW_AGENT_FEEDBACK_ENABLED=true
# Network that carries the public webhook route (Dokploy's default shown).
REVIEW_AGENT_INGRESS_NETWORK=dokploy-network

# --- Optional: admin panel (compose.admin.yaml) ---
# REVIEW_AGENT_ADMIN_IMAGE=review-agent-admin:local
# REVIEW_AGENT_ADMIN_PUBLIC_URL=https://admin.example.org
# Organization sign-in and SCIM; docs/ADMIN_PANEL.md#organization-sign-in-and-scim.
# REVIEW_AGENT_OIDC_ISSUER=
# REVIEW_AGENT_OIDC_CLIENT_ID=
# REVIEW_AGENT_OIDC_CLIENT_SECRET=
# REVIEW_AGENT_OIDC_NAME=Organization sign-in
# REVIEW_AGENT_SCIM_TOKEN=
# Fernet key for SMTP passwords saved in the panel; docs/ADMIN_PANEL.md#self-registration.
# REVIEW_AGENT_EMAIL_SECRET_KEY=
# Dokploy container state on the Health page (server-side API credential).
# REVIEW_AGENT_DOKPLOY_URL=
# REVIEW_AGENT_DOKPLOY_API_KEY=
# REVIEW_AGENT_DOKPLOY_COMPOSE_ID=

# --- Optional: provider accounts from the panel (compose.providers.yaml) ---
# REVIEW_AGENT_HERMES_CONTROL_TOKEN=

# --- Optional: code graph (compose.code-graph.yaml) ---
# REVIEW_AGENT_CODE_GRAPH_ENABLED=true
# REVIEW_AGENT_CODE_GRAPH_EMBEDDINGS=none
# For OpenAI embeddings. The overlay passes this only to the GitHub gateway.
# REVIEW_AGENT_OPENAI_API_KEY=
