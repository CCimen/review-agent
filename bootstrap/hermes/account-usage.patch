+def _codex_usage_text(value: Any) -> Optional[str]:
+    if value is None:
+        return None
+    if (
+        not isinstance(value, str)
+        or not 1 <= len(value) <= 200
+        or not value.isprintable()
+    ):
+        raise ValueError("Invalid quota text")
+    return value
+
+
+def _codex_usage_bool(value: Any) -> Optional[bool]:
+    if value is not None and type(value) is not bool:
+        raise ValueError("Invalid quota availability")
+    return value
+
+
+def _codex_usage_bucket(
+    raw: dict[str, Any],
+    bucket_id: str,
+    name: Optional[str] = None,
+    normal_model_slug: Optional[str] = None,
+) -> AccountUsageBucket:
+    rate_limit = raw.get("rate_limit")
+    if rate_limit is None:
+        rate_limit = {}
+    if not isinstance(rate_limit, dict):
+        raise ValueError("Invalid quota bucket")
+    windows: list[AccountUsageWindow] = []
+    for key, label in (
+        ("primary_window", "Primary"),
+        ("secondary_window", "Secondary"),
+    ):
+        window = rate_limit.get(key)
+        if window is None:
+            continue
+        if not isinstance(window, dict):
+            raise ValueError("Invalid quota window")
+        used = window.get("used_percent")
+        duration = window.get("limit_window_seconds")
+        reset = window.get("reset_at")
+        if used is not None and (not _is_finite_num(used) or used < 0):
+            raise ValueError("Invalid quota percentage")
+        if duration is not None and (
+            type(duration) is not int or not 0 < duration <= 2147483647
+        ):
+            raise ValueError("Invalid quota duration")
+        if reset is not None and (not _is_finite_num(reset) or reset < 0):
+            raise ValueError("Invalid quota reset")
+        windows.append(
+            AccountUsageWindow(
+                label=label,
+                used_percent=used,
+                duration_seconds=duration,
+                reset_at=_parse_dt(reset),
+                kind=key.removesuffix("_window"),
+            )
+        )
+    return AccountUsageBucket(
+        id=bucket_id,
+        name=name,
+        normal_model_slug=normal_model_slug,
+        allowed=_codex_usage_bool(rate_limit.get("allowed")),
+        limit_reached=_codex_usage_bool(rate_limit.get("limit_reached")),
+        windows=tuple(windows),
+    )
+
