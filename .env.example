HERMES_IMAGE=nousresearch/hermes-agent:v2026.8.3@sha256:16788311e2fa3035456bdc1bafb8ec2b1777db64ebf020af9bb7eb73c3712c9e
TZ=Europe/Stockholm
REVIEW_AGENT_PROFILE=sundsvall-standard

# One private PostgreSQL database serves each Review Agent environment. Use the
# same URL-safe random password in both values (for example: openssl rand -hex 32).
POSTGRES_IMAGE=postgres:17-alpine
REVIEW_AGENT_POSTGRES_PASSWORD=replace-with-one-url-safe-random-password
REVIEW_AGENT_DATABASE_URL=postgresql://review_agent:replace-with-one-url-safe-random-password@review-postgres:5432/review_agent

# Dokploy routes an HTTPS domain to container port 8644.
WEBHOOK_ENABLED=true
WEBHOOK_PORT=8644
WEBHOOK_SECRET=replace-with-output-of-openssl-rand-hex-32
REVIEW_AGENT_FEEDBACK_WEBHOOK_SECRET=replace-with-different-output-of-openssl-rand-hex-32

# Dedicated read token for PR metadata, diffs, and file reads.
# Repository access: only the reviewed repository.
# Permissions: Contents read, Pull requests read, Metadata read.
GITHUB_READ_TOKEN=replace-with-fine-grained-read-token

# Dedicated publisher token for deterministic comments and native review suggestions.
# Repository access: only the reviewed repository.
# Permissions: Metadata read, Pull requests read/write.
REVIEW_AGENT_PUBLISH_GH_TOKEN=replace-with-fine-grained-publisher-token
REVIEW_AGENT_PUBLISH_MAX_BYTES=60000
GH_PROMPT_DISABLED=1

# Dedicated feedback-sidecar token. Repository access: only the reviewed repository.
# Permissions: Pull requests read, Issues read/write, Metadata read.
REVIEW_AGENT_FEEDBACK_GH_TOKEN=replace-with-fine-grained-feedback-token

# Exact comma-separated repositories the platform may read.
REVIEW_AGENT_ALLOWED_REPOSITORIES=Sundsvallskommun/example-repository
REVIEW_AGENT_FEEDBACK_ALLOWED_ACTOR_IDS=12345678,23456789
REVIEW_AGENT_FEEDBACK_ENABLED=true

# Keep unrelated network surfaces disabled in phase one.
HERMES_DASHBOARD=0
API_SERVER_ENABLED=false
PYTHONUNBUFFERED=1
